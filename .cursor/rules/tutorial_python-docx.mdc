#### Ví dụ 7: Tạo document với nhiều sections
```python
from docx import Document
from docx.enum.section import WD_SECTION_START, WD_ORIENTATION
from docx.shared import Inches

doc = Document()

# Section 1 - Portrait
section1 = doc.sections[0]
section1.page_width = Inches(8.5)
section1.page_height = Inches(11)
section1.orientation = WD_ORIENTATION.PORTRAIT
section1.left_margin = Inches(1)
section1.right_margin = Inches(1)

doc.add_paragraph("Content in portrait section")

# Thêm section mới - Landscape
section2 = doc.add_section(WD_SECTION_START.NEW_PAGE)
section2.page_width = Inches(11)
section2.page_height = Inches(8.5)
section2.orientation = WD_ORIENTATION.LANDSCAPE
section2.left_margin = Inches(1.5)
section2.right_margin = Inches(1.5)

doc.add_paragraph("Content in landscape section")

# Section với first page header/footer
section3 = doc.add_section(WD_SECTION_START.ODD_PAGE)
section3.different_first_page_header_footer = True

# First page header
first_header = section3.first_page_header
first_header.paragraphs[0].text = "First Page Header"

# Regular header
header = section3.header
header.paragraphs[0].text = "Regular Header"

doc.save("multi-section.docx")
```

