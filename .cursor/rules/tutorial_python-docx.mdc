### 18. Ví dụ tổng hợp

#### Ví dụ 1: Tạo document cơ bản với formatting
```python
from docx import Document
from docx.shared import Inches, Pt, RGBColor
from docx.enum.text import WD_PARAGRAPH_ALIGNMENT, WD_BREAK, WD_LINE_SPACING
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.enum.dml import MSO_THEME_COLOR

# Tạo document mới
doc = Document()

# Đặt core properties
doc.core_properties.title = "My Document"
doc.core_properties.author = "John Doe"
doc.core_properties.subject = "Python Documentation"

# Thêm title
title = doc.add_heading("My Document", level=0)

# Thêm paragraph với format
para = doc.add_paragraph()
para.alignment = WD_PARAGRAPH_ALIGNMENT.CENTER
run = para.add_run("Centered text")
run.bold = True
run.font.size = Pt(14)
run.font.color.rgb = RGBColor(0, 0, 255)

# Paragraph với line spacing
para2 = doc.add_paragraph("This is a paragraph with custom line spacing.")
para2.paragraph_format.line_spacing = Pt(18)
para2.paragraph_format.line_spacing_rule = WD_LINE_SPACING.EXACTLY
para2.paragraph_format.space_before = Pt(12)
para2.paragraph_format.space_after = Pt(6)

# Thêm bảng
table = doc.add_table(rows=3, cols=3)
table.alignment = WD_TABLE_ALIGNMENT.CENTER
table.style = "Light Grid Accent 1"

# Điền dữ liệu vào bảng
for i, row in enumerate(table.rows):
    for j, cell in enumerate(row.cells):
        cell.text = f"Row {i}, Col {j}"
        if i == 0:  # Header row
            cell.paragraphs[0].runs[0].bold = True

# Thêm hình ảnh
doc.add_picture("image.jpg", width=Inches(2))

# Thêm page break
doc.add_page_break()

# Thêm section mới
section = doc.add_section()
section.left_margin = Inches(1.5)
section.right_margin = Inches(1.5)
section.top_margin = Inches(1)
section.bottom_margin = Inches(1)

# Thêm header và footer
header = section.header
header.paragraphs[0].text = "Header Text"
header.paragraphs[0].alignment = WD_PARAGRAPH_ALIGNMENT.CENTER

footer = section.footer
footer.paragraphs[0].text = "Page 1"
footer.paragraphs[0].alignment = WD_PARAGRAPH_ALIGNMENT.CENTER

# Lưu document
doc.save("output.docx")
```

