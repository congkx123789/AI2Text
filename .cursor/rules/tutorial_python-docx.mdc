#### Ví dụ 6: Sử dụng iter_inner_content
```python
from docx import Document

doc = Document("document.docx")

# Lặp qua tất cả paragraphs và tables
for item in doc.iter_inner_content():
    if isinstance(item, Paragraph):
        print(f"Paragraph: {item.text}")
    elif isinstance(item, Table):
        print(f"Table: {len(table.rows)} rows")

# Lặp qua nội dung trong paragraph
para = doc.paragraphs[0]
for item in para.iter_inner_content():
    if isinstance(item, Run):
        print(f"Run: {item.text}, Bold: {item.bold}")
    elif isinstance(item, Hyperlink):
        print(f"Hyperlink: {item.text}, URL: {item.url}")

# Lặp qua nội dung trong run
run = para.runs[0]
for item in run.iter_inner_content():
    if isinstance(item, str):
        print(f"Text: {item}")
    elif isinstance(item, RenderedPageBreak):
        print("Found rendered page break")
    elif isinstance(item, Drawing):
        print("Found drawing")
