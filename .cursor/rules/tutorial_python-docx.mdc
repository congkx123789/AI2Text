#### Ví dụ 5: Đọc và xử lý document có sẵn
```python
from docx import Document

# Mở document
doc = Document("existing.docx")

# Đọc paragraphs
for para in doc.paragraphs:
    print(f"Text: {para.text}")
    print(f"Style: {para.style.name if para.style else 'None'}")
    
    # Đọc runs
    for run in para.runs:
        print(f"  Run text: {run.text}")
        print(f"  Bold: {run.bold}")
        print(f"  Font: {run.font.name}")

# Đọc tables
for table in doc.tables:
    print(f"Table has {len(table.rows)} rows and {len(table.columns)} columns")
    for row in table.rows:
        for cell in row.cells:
            print(f"Cell: {cell.text}")

# Đọc comments
for comment in doc.comments:
    print(f"Comment by {comment.author}: {comment.text}")

# Đọc core properties
props = doc.core_properties
print(f"Title: {props.title}")
print(f"Author: {props.author}")
print(f"Created: {props.created}")
