#### Ví dụ 10: Làm việc với Row và Column chi tiết
```python
from docx import Document
from docx.shared import Inches, Pt
from docx.enum.table import WD_ROW_HEIGHT_RULE

doc = Document()
table = doc.add_table(rows=3, cols=3)

# Làm việc với Row
row = table.rows[0]

# Đặt height và height rule
row.height = Pt(20)
row.height_rule = WD_ROW_HEIGHT_RULE.EXACTLY

# Grid cols before/after
print(f"Grid cols before: {row.grid_cols_before}")
print(f"Grid cols after: {row.grid_cols_after}")

# Làm việc với Column
col = table.columns[0]

# Đặt width
col.width = Inches(2)
col.width = Pt(144)  # Tương đương 2 inches

# Lấy width
width = col.width  # Length hoặc None

# Lấy tất cả cells trong cột
cells = table.column_cells(0)
for cell in cells:
    print(cell.text)

# Làm việc với Cell
cell = table.cell(0, 0)

# Grid span (số cột merge)
print(f"Cell spans {cell.grid_span} columns")

# Width
cell.width = Inches(1.5)
```

#### Ví dụ 11: Xử lý RenderedPageBreak
```python
from docx import Document

doc = Document("document.docx")

# Kiểm tra và xử lý page breaks trong paragraphs
for para in doc.paragraphs:
    if para.contains_page_break:
        print(f"Paragraph contains page break: {para.text[:50]}...")
        
        for page_break in para.rendered_page_breaks:
            # Lấy fragment trước page break
            preceding = page_break.preceding_paragraph_fragment
            if preceding:
                print(f"  Text before break: {preceding.text}")
            
            # Lấy fragment sau page break
            following = page_break.following_paragraph_fragment
            if following:
                print(f"  Text after break: {following.text}")

# Kiểm tra page breaks trong runs
for para in doc.paragraphs:
    for run in para.runs:
        if run.contains_page_break:
            print(f"Run contains page break: {run.text}")
```

