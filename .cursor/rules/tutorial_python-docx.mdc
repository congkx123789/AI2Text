### 14. Tab Stops - Điểm dừng tab

#### Làm việc với Tab Stops:

```python
from docx.enum.text import WD_TAB_ALIGNMENT, WD_TAB_LEADER
from docx.shared import Inches, Twips

tab_stops = para.paragraph_format.tab_stops

# Thêm tab stop
tab_stop = tab_stops.add_tab_stop(
    position=Inches(2),
    alignment=WD_TAB_ALIGNMENT.LEFT,
    leader=WD_TAB_LEADER.SPACES  # Mặc định
)

# Tab stop với leader
tab_stop = tab_stops.add_tab_stop(
    position=Inches(3),
    alignment=WD_TAB_ALIGNMENT.RIGHT,
    leader=WD_TAB_LEADER.DOTS  # Dấu chấm
)

# Tab stop với negative position (hanging indent)
tab_stop = tab_stops.add_tab_stop(
    position=Pt(-12),  # Negative position
    alignment=WD_TAB_ALIGNMENT.LEFT
)

# Xóa tab stop
del tab_stops[0]  # Xóa tab stop đầu tiên
del tab_stops[-1]  # Xóa tab stop cuối cùng

# Xóa tất cả tab stops
tab_stops.clear_all()

# Các loại alignment
WD_TAB_ALIGNMENT.LEFT  # Căn trái
WD_TAB_ALIGNMENT.CENTER  # Căn giữa
WD_TAB_ALIGNMENT.RIGHT  # Căn phải
WD_TAB_ALIGNMENT.DECIMAL  # Căn theo dấu thập phân

# Leader (ký tự điền)
tab_stop.leader = WD_TAB_LEADER.DOTS  # Dấu chấm
tab_stop.leader = WD_TAB_LEADER.DASHES  # Dấu gạch ngang
tab_stop.leader = WD_TAB_LEADER.UNDERSCORE  # Dấu gạch dưới
tab_stop.leader = WD_TAB_LEADER.SPACES  # Khoảng trắng
tab_stop.leader = None  # Không có leader

# Thay đổi position
tab_stop.position = Inches(3)

# Thay đổi alignment
tab_stop.alignment = WD_TAB_ALIGNMENT.RIGHT

# Lấy tab stop theo position
tab_stop = tab_stops.get_by_position(Inches(2))

# Xóa tab stop
tab_stops.clear_all()

# Lặp qua tất cả tab stops
for tab_stop in tab_stops:
    print(f"Position: {tab_stop.position}, Alignment: {tab_stop.alignment}")
```

