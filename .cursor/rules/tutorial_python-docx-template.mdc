# Kiểm tra headers/footers có tồn tại
for relKey, part in tpl.get_headers_footers(tpl.HEADER_URI):
    print(f"Header found: {relKey}")

for relKey, part in tpl.get_headers_footers(tpl.FOOTER_URI):
    print(f"Footer found: {relKey}")
```

