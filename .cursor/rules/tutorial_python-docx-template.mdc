            "type": "WARNING",
            "bg": "FFDD00",  # Màu vàng
        },
        {
            "date": "2024-01-12",
            "desc": RichText("Information"),
            "type": "INFO",
            "bg": "8888FF",  # Màu xanh
        },
    ],
}

tpl.render(context)
tpl.save("output/alerts_table.docx")
