### 5. InlineImage - Chèn Hình Ảnh

**Ví dụ từ `tests/inline_image.py`:**

```python
from docxtpl import DocxTemplate, InlineImage
from docx.shared import Mm
import jinja2

tpl = DocxTemplate("templates/inline_image_tpl.docx")

context = {
    # Hình ảnh đơn giản với width
    "myimage": InlineImage(tpl, "templates/python_logo.png", width=Mm(20)),
    
    # Hình ảnh với width và height
    "myimageratio": InlineImage(
        tpl, "templates/python_jpeg.jpg", width=Mm(30), height=Mm(60)
    ),
    
    # Hình ảnh trong loop
    "frameworks": [
        {
            "image": InlineImage(tpl, "templates/django.png", height=Mm(10)),
            "desc": "The web framework for perfectionists with deadlines",
        },
        {
            "image": InlineImage(tpl, "templates/zope.png", height=Mm(10)),
            "desc": "Zope is a leading Open Source Application Server",
        },
        {
            "image": InlineImage(tpl, "templates/pyramid.png", height=Mm(10)),
            "desc": "Pyramid is a lightweight Python web framework",
        },
    ],
}

# Có thể dùng với autoescape
jinja_env = jinja2.Environment(autoescape=True)
tpl.render(context, jinja_env)
tpl.save("output/inline_image.docx")
```

**Template Word:**
```
{{ myimage }}

{% for fw in frameworks %}
{{ fw.image }} - {{ fw.desc }}
{% endfor %}
```

**Đơn vị đo lường:**
```python
from docx.shared import Mm, Inches, Pt, Cm

# Millimeters
img = InlineImage(tpl, "img.png", width=Mm(50))

# Inches
img = InlineImage(tpl, "img.png", width=Inches(2))

# Points
img = InlineImage(tpl, "img.png", width=Pt(144))

# Centimeters
img = InlineImage(tpl, "img.png", width=Cm(5))
```

