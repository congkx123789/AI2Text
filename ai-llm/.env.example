# Fine-tuned Models Configuration

# Whisper ASR Model (CTranslate2 format for faster-whisper)
ASR_FINETUNED_MODEL=./models/final/whisper-vi-en-ct2

# Qwen LLM Model (Merged from LoRA)
GEN_FINETUNED_MODEL=./models/finetuned/qwen-mixed-merged

# Device Configuration
ASR_DEVICE=auto
ASR_COMPUTE=float16

# Generation Configuration
GEN_MAX_TOKENS=512

# RAG Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Data Directories
DATA_DIR=./data
VECTOR_DIR=./vectorstore
MODELS_DIR=./models
